<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the scrolling widget list (Android 12+) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingTop="5dp" android:paddingBottom="5dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/i_t" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#E6EDF3" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/i_m" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#8B98A8" android:textSize="11.5sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/i_v" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#D4AF37" android:textSize="14sp" android:textStyle="bold" android:paddingStart="8dp" android:paddingEnd="8dp" />
    <TextView android:id="@+id/i_b" android:layout_width="40dp" android:layout_height="38dp" android:gravity="center"
        android:background="@drawable/widget_tick_bg" android:text="✓" android:textColor="#3FCF6E" android:textSize="20sp" android:textStyle="bold" />
</LinearLayout>
